{
  "name": "folio-frontend",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "pids=$(lsof -ti:1420 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids; vite",
    "build": "vite build",
    "check": "node scripts/check-quality.mjs && node --check main.js && for file in modules/*.js vite.config.js; do node --check \"$file\"; done",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "leaflet": "^1.9.4"
  }
}
